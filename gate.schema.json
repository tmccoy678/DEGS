{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dobeworks.local/schemas/degs-engineering-task-1.1.0.json",
  "title": "Dobeworks EGS Engineering Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "objective",
    "authority_lane",
    "risk_tier",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"risk_tier": {"const": "TIER_3"}},
        "required": ["risk_tier"]
      },
      "then": {
        "required": ["human_approval", "hazard_analysis"],
        "properties": {
          "human_approval": {
            "required": ["status", "approver", "approver_role", "approval_mode", "evidence_path"],
            "properties": {
              "status": {"const": "APPROVED"},
              "approver": {"const": "Taylor"},
              "approver_role": {"const": "HUMAN"},
              "approval_mode": {"const": "OUT_OF_BAND"},
              "evidence_path": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"risk_tier": {"enum": ["TIER_2", "TIER_3"]}},
        "required": ["risk_tier"]
      },
      "then": {
        "required": ["task_author", "deterministic_controls", "artifact_identity", "change_traceability", "data_governance", "threat_model", "ai_assurance", "monitoring", "verification", "validation", "independent_review"],
        "properties": {
          "verification": {"$ref": "#/$defs/verificationValidationEvidence"},
          "validation": {"$ref": "#/$defs/verificationValidationEvidence"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"not": {"const": "PLANNED"}}},
        "required": ["status"]
      },
      "then": {"$ref": "#/$defs/readyPlanning"}
    }
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_author": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "stakeholders": {"type": "array", "items": {"type": "string"}},
    "scope": {"$ref": "#/$defs/evidenceObject"},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "authority_lane": {"enum": ["COMMAND_CENTER", "TAYLOR_AI_WORKBENCH", "AGENTOPS", "TAYLOR"]},
    "risk_tier": {"enum": ["TIER_0", "TIER_1", "TIER_2", "TIER_3"]},
    "requirements": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "baseline": {"$ref": "#/$defs/evidenceObject"},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "selected_design": {"type": ["string", "null"]},
    "affected_files": {"type": "array", "items": {"type": "string"}},
    "backup": {"$ref": "#/$defs/evidenceObject"},
    "rollback": {"$ref": "#/$defs/evidenceObject"},
    "risk_analysis": {"$ref": "#/$defs/riskAnalysis"},
    "deterministic_controls": {"$ref": "#/$defs/deterministicControls"},
    "artifact_identity": {"$ref": "#/$defs/artifactIdentity"},
    "change_traceability": {"$ref": "#/$defs/changeTraceability"},
    "data_governance": {"$ref": "#/$defs/dataGovernance"},
    "threat_model": {"$ref": "#/$defs/threatModel"},
    "ai_assurance": {"$ref": "#/$defs/aiAssurance"},
    "monitoring": {"$ref": "#/$defs/monitoring"},
    "hazard_analysis": {"$ref": "#/$defs/hazardAnalysis"},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static": {"$ref": "#/$defs/evidenceArray"},
        "positive": {"$ref": "#/$defs/evidenceArray"},
        "negative": {"$ref": "#/$defs/evidenceArray"},
        "security": {"$ref": "#/$defs/evidenceArray"},
        "failure_path": {"$ref": "#/$defs/evidenceArray"},
        "integration": {"$ref": "#/$defs/evidenceArray"},
        "end_to_end": {"$ref": "#/$defs/evidenceArray"}
      }
    },
    "verification": {"$ref": "#/$defs/evidenceObject"},
    "validation": {"$ref": "#/$defs/evidenceObject"},
    "independent_review": {"$ref": "#/$defs/independentReview"},
    "human_approval": {"$ref": "#/$defs/humanApproval"},
    "recovery_validation": {"$ref": "#/$defs/evidenceObject"},
    "target_identity": {"type": ["string", "object", "null"]},
    "blast_radius": {"type": ["string", "object", "null"]},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "post_action_validation": {"$ref": "#/$defs/evidenceObject"},
    "dry_run": {"$ref": "#/$defs/evidenceObject"},
    "telemetry": {"$ref": "#/$defs/evidenceObject"},
    "documentation": {"$ref": "#/$defs/evidenceObject"},
    "handoff": {"$ref": "#/$defs/evidenceObject"},
    "secret_handling": {"$ref": "#/$defs/evidenceObject"},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "unresolved_items": {"type": "array", "items": {"oneOf": [
      {"$ref": "#/$defs/nonblankString"},
      {"$ref": "#/$defs/activeWarning"}
    ]}},
    "status": {"enum": ["PLANNED", "READY_FOR_EXECUTION", "IN_PROGRESS", "BLOCKED", "COMPLETE", "FAILED"]}
  },
  "$defs": {
    "nonblankString": {"type": "string", "pattern": "\\S"},
    "nonblankStringList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonblankString"}
    },
    "readyPlanning": {
      "required": ["scope"],
      "properties": {
        "objective": {"$ref": "#/$defs/nonblankString"},
        "scope": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": {"$ref": "#/$defs/nonblankString"},
            "read_only": {"type": "boolean"}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"risk_tier": {"enum": ["TIER_1", "TIER_2", "TIER_3"]}}, "required": ["risk_tier"]},
        "then": {
          "required": ["requirements", "acceptance_criteria"],
          "properties": {
            "requirements": {"$ref": "#/$defs/nonblankStringList"},
            "acceptance_criteria": {"$ref": "#/$defs/nonblankStringList"},
            "rollback": {"$ref": "#/$defs/readyRollback"}
          }
        }
      }, {
        "if": {"properties": {"risk_tier": {"enum": ["TIER_2", "TIER_3"]}}, "required": ["risk_tier"]},
        "then": {
          "required": ["backup", "rollback"],
          "properties": {
            "backup": {"$ref": "#/$defs/readyEvidence"},
            "rollback": {
              "required": ["procedure"],
              "properties": {"procedure": {"$ref": "#/$defs/nonblankString"}}
            }
          }
        }
      }, {
        "if": {"properties": {"risk_tier": {"const": "TIER_3"}}, "required": ["risk_tier"]},
        "then": {
          "required": ["target_identity", "blast_radius", "stop_conditions", "recovery_validation", "post_action_validation", "dry_run"],
          "properties": {
            "target_identity": {
              "type": "object", "required": ["identifier", "verified"],
              "properties": {"identifier": {"$ref": "#/$defs/nonblankString"}, "verified": {"const": true}}
            },
            "blast_radius": {
              "type": "object", "required": ["description", "bounded"],
              "properties": {"description": {"$ref": "#/$defs/nonblankString"}, "bounded": {"const": true}}
            },
            "stop_conditions": {"$ref": "#/$defs/nonblankStringList"},
            "recovery_validation": {
              "allOf": [{"$ref": "#/$defs/readyEvidence"}],
              "required": ["independently_verified"],
              "properties": {"independently_verified": {"const": true}}
            },
            "post_action_validation": {"$ref": "#/$defs/readyEvidence"},
            "dry_run": {"$ref": "#/$defs/readyDryRun"}
          }
        }
      }]
    },
    "readyEvidence": {
      "type": "object", "required": ["status", "evidence_path"],
      "properties": {"status": {"type": "string"}, "evidence_path": {"$ref": "#/$defs/nonblankString"}}
    },
    "readyRollback": {
      "type": "object",
      "properties": {"procedure": {"type": "string"}, "reason": {"type": "string"}, "required": {"type": "boolean"}},
      "allOf": [{
        "if": {"properties": {"status": {"pattern": "^(?:[Pp][Aa][Ss][Ss]|[Vv][Ee][Rr][Ii][Ff][Ii][Ee][Dd])$"}}, "required": ["status"]},
        "then": {"required": ["procedure"], "properties": {"procedure": {"$ref": "#/$defs/nonblankString"}}}
      }, {
        "if": {
          "properties": {"required": {"const": false}}, "required": ["required"],
          "not": {"properties": {"status": {"pattern": "^(?:[Pp][Aa][Ss][Ss]|[Vv][Ee][Rr][Ii][Ff][Ii][Ee][Dd])$"}}, "required": ["status"]}
        },
        "then": {"required": ["reason"], "properties": {"reason": {"$ref": "#/$defs/nonblankString"}}}
      }]
    },
    "readyDryRun": {
      "type": "object",
      "oneOf": [{
        "required": ["applicable", "performed", "status", "evidence_path"],
        "properties": {
          "applicable": {"const": true}, "performed": {"const": true}, "status": {"const": "PASS"},
          "evidence_path": {"$ref": "#/$defs/nonblankString"}
        }
      }, {
        "required": ["applicable", "reason"],
        "properties": {"applicable": {"const": false}, "reason": {"$ref": "#/$defs/nonblankString"}}
      }]
    },
    "evidenceObject": {
      "type": "object",
      "additionalProperties": true
    },
    "verificationValidationEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "evidence_path"],
      "properties": {
        "status": {"enum": ["PASS", "VERIFIED"]},
        "evidence_path": {"type": "string", "pattern": "\\S"}
      }
    },
    "evidenceArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/testEvidence"}
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "evidence_path"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "pattern": "\\S"}
      }
    },
    "planningControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"const": "PENDING"}}
    },
    "measurableCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measure", "threshold", "evidence_path"],
      "properties": {
        "measure": {"type": "string", "minLength": 1},
        "threshold": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1}
      }
    },
    "riskAnalysis": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"const": "NOT_REQUIRED"},
            "summary": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "factors", "summary", "evidence_path"],
          "properties": {
            "status": {"enum": ["PASS", "COMPLETE"]},
            "factors": {
              "type": "object",
              "additionalProperties": false,
              "required": ["consequence", "reversibility", "data_sensitivity", "operational_reach", "physical_effects", "affected_party_impact", "ai_socio_technical_risk"],
              "properties": {
                "consequence": {"type": "string", "minLength": 1},
                "reversibility": {"type": "string", "minLength": 1},
                "data_sensitivity": {"type": "string", "minLength": 1},
                "operational_reach": {"type": "string", "minLength": 1},
                "physical_effects": {"type": "string", "minLength": 1},
                "affected_party_impact": {"type": "string", "minLength": 1},
                "ai_socio_technical_risk": {"type": "string", "minLength": 1}
              }
            },
            "summary": {"type": "string", "minLength": 1},
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "controlBoundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "mechanism"],
          "properties": {
            "status": {"const": "ENFORCED"},
            "mechanism": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "NOT_APPLICABLE"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "deterministicControls": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "enforced_outside_model", "boundaries", "denial_test", "post_change_verification", "evidence_path"],
          "properties": {
            "status": {"const": "VERIFIED"},
            "enforced_outside_model": {"const": true},
            "boundaries": {
              "type": "object",
              "additionalProperties": false,
              "required": ["filesystem_write", "command_execution", "network_egress", "dependency_sources", "secret_access", "approval"],
              "properties": {
                "filesystem_write": {"$ref": "#/$defs/controlBoundary"},
                "command_execution": {"$ref": "#/$defs/controlBoundary"},
                "network_egress": {"$ref": "#/$defs/controlBoundary"},
                "dependency_sources": {"$ref": "#/$defs/controlBoundary"},
                "secret_access": {"$ref": "#/$defs/controlBoundary"},
                "approval": {"$ref": "#/$defs/controlBoundary"}
              }
            },
            "denial_test": {"$ref": "#/$defs/evidenceObject"},
            "post_change_verification": {"$ref": "#/$defs/evidenceObject"},
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "artifactIdentity": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "configuration_version", "canonical_path", "reviewed_identifier", "tested_identifier", "execution_identifier", "handoff_identifier", "match", "provenance", "evidence_freshness", "evidence_path"],
          "properties": {
            "status": {"const": "VERIFIED"},
            "method": {"enum": ["SHA256", "SIGNATURE", "COMMIT", "RELEASE_DIGEST", "EQUIVALENT"]},
            "configuration_version": {"type": "string", "minLength": 1},
            "canonical_path": {"type": "string", "minLength": 1},
            "reviewed_identifier": {"type": "string", "minLength": 1},
            "tested_identifier": {"type": "string", "minLength": 1},
            "execution_identifier": {"type": "string", "minLength": 1},
            "handoff_identifier": {"type": "string", "minLength": 1},
            "match": {"const": true},
            "provenance": {"type": "string", "minLength": 1},
            "evidence_freshness": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "verified_at", "basis"],
              "properties": {
                "status": {"const": "CURRENT"},
                "verified_at": {"type": "string", "minLength": 1},
                "basis": {"type": "string", "minLength": 1}
              }
            },
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "changeTraceability": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "orphan_count", "links", "evidence_path"],
          "properties": {
            "status": {"const": "VERIFIED"},
            "orphan_count": {"const": 0},
            "links": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["requirement", "artifact", "tests", "evidence_path"],
                "properties": {
                  "requirement": {"type": "string", "minLength": 1},
                  "artifact": {"type": "string", "minLength": 1},
                  "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "evidence_path": {"type": "string", "minLength": 1}
                }
              }
            },
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "dataGovernance": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "status", "reason"],
          "properties": {
            "applicable": {"const": false},
            "status": {"const": "NOT_APPLICABLE"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "status", "purpose", "owner", "data_classes", "necessary_fields", "minimum_necessary", "provenance", "authority", "retention", "deletion_or_archival_conditions", "access_boundary", "repurposing", "evidence_path"],
          "properties": {
            "applicable": {"const": true},
            "status": {"const": "VERIFIED"},
            "purpose": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1},
            "data_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "necessary_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "minimum_necessary": {"const": true},
            "provenance": {"type": "string", "minLength": 1},
            "authority": {"type": "string", "pattern": "\\S", "not": {"pattern": "^\\s*[Uu][Nn][Kk][Nn][Oo][Ww][Nn]\\s*$"}},
            "retention": {"type": "string", "minLength": 1},
            "deletion_or_archival_conditions": {"type": "string", "minLength": 1},
            "access_boundary": {"type": "string", "minLength": 1},
            "repurposing": {
              "type": "object",
              "additionalProperties": false,
              "required": ["planned"],
              "properties": {
                "planned": {"type": "boolean"},
                "status": {"const": "AUTHORIZED"},
                "purpose": {"type": "string", "minLength": 1},
                "authority": {"type": "string", "pattern": "\\S", "not": {"pattern": "^\\s*[Uu][Nn][Kk][Nn][Oo][Ww][Nn]\\s*$"}},
                "evidence_path": {"type": "string", "minLength": 1}
              },
              "allOf": [
                {
                  "if": {"properties": {"planned": {"const": true}}, "required": ["planned"]},
                  "then": {"required": ["status", "purpose", "authority", "evidence_path"]}
                }
              ]
            },
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "threatModel": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "status", "reason"],
          "properties": {
            "applicable": {"const": false},
            "status": {"const": "NOT_APPLICABLE"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "status", "reviewed_after_last_material_change", "threats", "mitigations", "evidence_path"],
          "properties": {
            "applicable": {"const": true},
            "status": {"const": "CURRENT"},
            "reviewed_after_last_material_change": {"const": true},
            "threats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "mitigations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "monitoring": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "status", "reason"],
          "properties": {
            "applicable": {"const": false},
            "status": {"const": "NOT_APPLICABLE"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "status", "owner", "expected_operating_range", "alert_thresholds", "stop_thresholds", "reassessment_triggers", "safe_degradation", "evidence_path"],
          "properties": {
            "applicable": {"const": true},
            "status": {"const": "VERIFIED"},
            "owner": {"type": "string", "minLength": 1},
            "expected_operating_range": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "alert_thresholds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "stop_thresholds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "reassessment_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "safe_degradation": {"type": "string", "minLength": 1},
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "aiAssurance": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "status", "reason"],
          "properties": {
            "applicable": {"const": false},
            "status": {"const": "NOT_APPLICABLE"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "status", "consequential", "intended_uses", "unsupported_uses", "affected_stakeholders", "provenance", "foreseeable_misuse", "operating_bounds", "criteria", "human_decision_owner", "override_path", "stop_path", "fallback_path", "rollback_path", "monitoring_and_reassessment_triggers", "retirement_condition", "representative_tests", "limitations", "evidence_path"],
          "properties": {
            "applicable": {"const": true},
            "status": {"const": "VERIFIED"},
            "consequential": {"const": true},
            "intended_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "unsupported_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "affected_stakeholders": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "provenance": {"type": "string", "minLength": 1},
            "foreseeable_misuse": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "operating_bounds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "criteria": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quality", "safety", "security", "fairness"],
              "properties": {
                "quality": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurableCriterion"}},
                "safety": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurableCriterion"}},
                "security": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurableCriterion"}},
                "fairness": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/measurableCriterion"}}
              }
            },
            "human_decision_owner": {"const": "Taylor"},
            "override_path": {"type": "string", "minLength": 1},
            "stop_path": {"type": "string", "minLength": 1},
            "fallback_path": {"type": "string", "minLength": 1},
            "rollback_path": {"type": "string", "minLength": 1},
            "monitoring_and_reassessment_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "retirement_condition": {"type": "string", "minLength": 1},
            "representative_tests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "representative", "adversarial", "human_handoff", "evidence_path"],
              "properties": {
                "status": {"const": "PASS"},
                "representative": {"const": true},
                "adversarial": {"const": true},
                "human_handoff": {"const": true},
                "evidence_path": {"type": "string", "minLength": 1}
              }
            },
            "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "hazardAnalysis": {
      "oneOf": [
        {"$ref": "#/$defs/planningControl"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "hazards", "cross_domain_check", "residual_risk", "evidence_path"],
          "properties": {
            "status": {"const": "COMPLETE"},
            "hazards": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hazard_id", "description", "disposition", "control", "test_status", "evidence_path"],
                "properties": {
                  "hazard_id": {"type": "string", "minLength": 1},
                  "description": {"type": "string", "minLength": 1},
                  "disposition": {"enum": ["ELIMINATED", "MITIGATED"]},
                  "control": {"type": "string", "minLength": 1},
                  "test_status": {"const": "PASS"},
                  "evidence_path": {"type": "string", "minLength": 1}
                }
              }
            },
            "cross_domain_check": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "evidence_path"],
              "properties": {
                "status": {"const": "PASS"},
                "evidence_path": {"type": "string", "minLength": 1}
              }
            },
            "residual_risk": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "description"],
                  "properties": {
                    "status": {"const": "NONE"},
                    "description": {"type": "string", "minLength": 1}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "description", "acceptor", "acceptor_role", "acceptance_mode", "evidence_path"],
                  "properties": {
                    "status": {"const": "ACCEPTED"},
                    "description": {"type": "string", "minLength": 1},
                    "acceptor": {"const": "Taylor"},
                    "acceptor_role": {"const": "HUMAN"},
                    "acceptance_mode": {"const": "OUT_OF_BAND"},
                    "evidence_path": {"type": "string", "minLength": 1}
                  }
                }
              ]
            },
            "evidence_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "humanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["PENDING", "APPROVED", "REJECTED", "MISSING", "NOT_REQUIRED"]},
        "approver": {"type": "string"},
        "approver_role": {"enum": ["HUMAN", "AGENT"]},
        "approval_mode": {"enum": ["OUT_OF_BAND", "IN_BAND"]},
        "evidence_path": {"type": "string"}
      }
    },
    "independentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["PENDING", "PASS", "PASS_WITH_WARNINGS", "FAIL", "MISSING", "NOT_REQUIRED"]},
        "kind": {"enum": ["REVIEW", "AUDIT"]},
        "reviewer": {"type": "string"},
        "reviewer_role": {"type": "string"},
        "open_issues_status": {"enum": ["NONE", "DISPOSITIONED", "OPEN", "UNKNOWN"]},
        "retest_status": {"enum": ["PASS", "FAIL", "PENDING", "NOT_REQUIRED"]},
        "evidence_path": {"type": "string"}
      }
    },
    "warning": {
      "type": "object",
      "required": ["severity", "resolved", "status"],
      "properties": {
        "severity": {"enum": ["NONE", "INFO", "WARNING", "CRITICAL"]},
        "message": {"type": "string"},
        "resolved": {"type": "boolean"},
        "status": {"enum": ["UNRESOLVED", "RESOLVED"]},
        "evidence_path": {"$ref": "#/$defs/nonblankString"}
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "severity": {"enum": ["INFO", "WARNING", "CRITICAL"]},
            "resolved": {"const": false},
            "status": {"const": "UNRESOLVED"}
          }
        },
        {
          "required": ["evidence_path"],
          "properties": {
            "severity": {"const": "NONE"},
            "resolved": {"const": true},
            "status": {"const": "RESOLVED"}
          }
        }
      ]
    },
    "activeWarning": {
      "allOf": [
        {"$ref": "#/$defs/warning"},
        {"properties": {"resolved": {"const": false}, "status": {"const": "UNRESOLVED"}}}
      ]
    }
  }
}
